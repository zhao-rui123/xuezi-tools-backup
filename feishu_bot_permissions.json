    "im:message:send_as_bot",
    "im:chat:create",
    "im:chat:update",
    "im:chat:delete",
    "im:chat:list",
    "im:chat:read",
    "im:chat.member:create",
    "im:chat.member:update",
    "im:chat.member:delete",
